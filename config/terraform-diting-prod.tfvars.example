# 复制为 terraform-diting-prod.tfvars 后本地填写；勿提交含真实密码/机密的文件。
# instance_password 建议用环境变量：export TF_VAR_instance_password='...' 再 make deploy diting prod
# [Ref: config/README.md]

env_id            = "prod"
region            = "cn-hongkong"
instance_type     = "ecs.u1-c1m4.xlarge"
# instance_password 用 export TF_VAR_instance_password='...' 注入，勿写在此文件
vpc_cidr          = "10.0.0.0/16"
vswitch_cidr      = "10.0.1.0/24"
enable_spot       = true
spot_strategy     = "SpotAsPriceGo"
spot_price_limit  = 0.5
eip_bandwidth     = 100
disk_category     = "cloud_essd"

# 安全组入向 SSH/K8s API 授权网段（Terraform 若写规则时用）
ssh_allowed_cidr = "0.0.0.0/0"

# 固定资源 ID（复用已有 VPC/交换机/安全组/NAS 时填写）
vpc_existing_id                  = ""
vswitch_existing_id              = ""
security_group_existing_id       = ""
nas_existing_file_system_id      = ""
nas_existing_access_group_name   = ""
# 复用 NAS 挂载点（文件系统每地域挂载点数量上限时启用）
nas_use_existing_mount_target    = false
nas_existing_mount_target_domain = ""

# 磁盘：首次部署留空；Down 保留盘后再次 Up 由 prod.disk_id / TF_VAR_use_existing_data_disk_id 挂载同盘
use_existing_data_disk_id = ""

enable_prod_data_disk = true
data_disk_size        = 100
data_disk_category    = "cloud_essd"

oss_bucket_name = "deploy-engine-k3s-storage"
oss_bucket_acl  = "public-read-write"
init_script_acl = "public-read"
