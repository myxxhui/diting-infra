# [Ref: 03_原子目标与规约/_共享规约/02_三位一体仓库规约] 占位，禁止填写真实 Key
# 与 diting-src .env.template 一致（应用变量以 core 为权威）；可多出 infra 专用项（如 ACR、TF_VAR_*）
# 本地实践时：在 diting-src 复制其 .env.template 为 .env 并填写；本文件供 infra 侧文档/Secret 键名参考

# ---------- 必填（diting-src 拉代码后本地/联调必备）----------
# L1 TimescaleDB（OHLCV）；示例：postgresql://user:pass@host:port/dbname；本地 compose 端口 15432
TIMESCALE_DSN=

# L2 知识库 PostgreSQL；示例：postgresql://user:pass@host:5432/dbname；本地 compose 端口 15433
PG_L2_DSN=

# Redis；示例：redis://:pass@host:6379/0；本地 compose 端口 15479
REDIS_URL=

# ---------- 可选 ----------
API_KEY=
DB_URL=

# ---------- diting-infra 部署凭证（复制本文件为 .env 后填写 · 已在 .gitignore）----------
# 阿里云 RAM 子账号（make deploy 时 Makefile -include .env 自动加载）
# ALICLOUD_ACCESS_KEY=
# ALICLOUD_SECRET_KEY=
# P-step_01 文档兼容别名（与 ALICLOUD_* 同值即可）
# ALIYUN_AK=
# ALIYUN_SK=
# ECS root 密码（≥8 位 · 勿写入 config/terraform-diting-prod.tfvars 明文）
# TF_VAR_instance_password=
# ACR 香港个人版（docker login · 与 charts/.../acr-pull-secret 同源）
# ACR_REGISTRY=crpi-7vifw4ok9jkcxr60.cn-hongkong.personal.cr.aliyuncs.com
# ACR_USER=
# ACR_PASSWORD=

# 触发采集 Job 时覆盖镜像（与 Makefile deploy-ingest-job、charts/ingest 一致）
# INGEST_IMAGE=<registry>/<命名空间>/diting-ingest:test

# 外网不可达或 CI：DITING_INGEST_MOCK=1 使用 mock 数据
# 连接已部署 K3s：KUBECONFIG=、PUBLIC_IP= 见 diting-src .env.template；端口见 config/README.md

# ---------- 新加坡 Anthropic 出口代理（VPS / deploy-sg-anthropic-proxy）----------
# sync-anthropic-proxy-to-copilot.sh 用下列键拼 ANTHROPIC_HTTPS_PROXY 写入 diting-src/.env（不写进 Pod 的 HTTPS_PROXY）
# 密码回退顺序：ANTHROPIC_PROXY_PASSWORD → 本文件 TF_VAR_instance_password → diting-src/.env 内同键
# ANTHROPIC_PROXY_PASSWORD=
# ANTHROPIC_PROXY_USER=ditingproxy
# ANTHROPIC_PROXY_HOST=   # 或部署后 sg-proxy.conn 的 SG_PROXY_PUBLIC_IP
# ANTHROPIC_PROXY_PORT=3128

# DeepSeek / 雷达 T1·T2 / ANTHROPIC_HTTPS_PROXY 均在 diting-src/.env（见 diting-src/.env.template § DeepSeek）
