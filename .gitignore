# 本地凭证（阿里云 AK/SK、TF_VAR_instance_password、ACR 等）
# 勿提交 .env（见 .env.template）
.env

# 生产环境连接信息与数据盘 ID（含敏感信息；见 06_生产级数据要求_实践）
prod.conn
prod.disk_id
prod.snapshot_policy_id
sg-proxy.conn

# 部署非阻塞告警（make deploy diting prod 运行时写入，收尾汇总后删除）
.deploy-warnings

# 生产 Terraform 变量（含 instance_password 等敏感项；请用 config/terraform-diting-prod.tfvars.example 复制后本地填写，并用 TF_VAR_instance_password 注入密码）
config/.generated/
config/.spot-active/
config/.spot-billing-state.json
config/.spot-watch-last-report.json

# ACR 拉取凭证（含密码）；若需重建请参考 charts/diting-stack/manifests/acr-pull-secret.yaml.example
charts/diting-stack/manifests/acr-pull-secret.yaml
